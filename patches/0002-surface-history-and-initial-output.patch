+/// `bytes` with everything but display removed: printable text, CR, LF,
+/// tab, and SGR sequences (`ESC [` digits, `;`, `:` and a final `m`).
+/// Every other C0 control, DEL, C1 control (U+0080 to U+009F), and escape
+/// sequence is dropped, each escape sequence whole, so none of its bytes
+/// print as text. Printing, line movement, and SGR only change terminal
+/// state; none of them goes through a stream handler message writer, the
+/// path that can block on a full worker queue.
+fn displayOnlyOutput(alloc: Allocator, bytes: []const u8) Allocator.Error![]u8 {
+    var out: std.ArrayList(u8) = .empty;
+    errdefer out.deinit(alloc);
+    try out.ensureTotalCapacity(alloc, bytes.len);
+    var i: usize = 0;
+    while (i < bytes.len) {
+        const byte = bytes[i];
+        switch (byte) {
+            '\n', '\r', '\t' => {
+                out.appendAssumeCapacity(byte);
+                i += 1;
+            },
+            0x1B => i = displayOnlyEscape(bytes, i, &out),
+            0x00...0x08, 0x0B, 0x0C, 0x0E...0x1A, 0x1C...0x1F, 0x7F => i += 1,
+            0xC2 => if (i + 1 < bytes.len and bytes[i + 1] >= 0x80 and bytes[i + 1] <= 0x9F) {
+                i += 2;
+            } else {
+                out.appendAssumeCapacity(byte);
+                i += 1;
+            },
+            else => {
+                out.appendAssumeCapacity(byte);
+                i += 1;
+            },
+        }
+    }
+    return out.toOwnedSlice(alloc);
+}
+
+/// Handle the escape sequence starting at `bytes[start]` (an ESC) for
+/// `displayOnlyOutput`: append it to `out` if it is SGR, and return the
+/// index just past it either way. An unterminated sequence runs to the
+/// end of `bytes`.
+fn displayOnlyEscape(bytes: []const u8, start: usize, out: *std.ArrayList(u8)) usize {
+    if (start + 1 >= bytes.len) return bytes.len;
+    const kind = bytes[start + 1];
+    switch (kind) {
+        // CSI: parameters and intermediates up to a final byte.
+        '[' => {
+            var j = start + 2;
+            var sgr = true;
+            while (j < bytes.len) : (j += 1) {
+                const c = bytes[j];
+                if (c >= 0x40 and c <= 0x7E) break;
+                switch (c) {
+                    '0'...'9', ';', ':' => {},
+                    else => sgr = false,
+                }
+            }
+            if (j >= bytes.len) return bytes.len;
+            if (sgr and bytes[j] == 'm') out.appendSliceAssumeCapacity(bytes[start .. j + 1]);
+            return j + 1;
+        },
+        // OSC ends at BEL or ST; DCS, SOS, PM, and APC end at ST.
+        ']', 'P', 'X', '^', '_' => {
+            var j = start + 2;
+            while (j < bytes.len) : (j += 1) {
+                if (kind == ']' and bytes[j] == 0x07) return j + 1;
+                if (bytes[j] == 0x1B and j + 1 < bytes.len and bytes[j + 1] == '\\') return j + 2;
+            }
+            return bytes.len;
+        },
+        // Intermediates, then one final byte (e.g. ESC ( B).
+        0x20...0x2F => {
+            var j = start + 2;
+            while (j < bytes.len and bytes[j] >= 0x20 and bytes[j] <= 0x2F) : (j += 1) {}
+            return @min(j + 1, bytes.len);
+        },
+        else => return start + 2,
+    }
+}
