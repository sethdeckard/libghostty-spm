+    /// Read the primary screen's history in the given format: its last
+    /// `max_rows` rows, from scrollback down to the row holding the
+    /// cursor. Rows below the cursor are excluded, even if they contain
+    /// text.
+    ///
+    /// Always reads the primary screen, never the alternate one, so a
+    /// full-screen program such as an editor doesn't stand in for the
+    /// shell's history while it runs.
+    ///
+    /// Formatting is as for ghostty_surface_read_text_format. Free the
+    /// result with ghostty_surface_free_text. This is an expensive
+    /// operation; call it rarely.
+    export fn ghostty_surface_read_history(
+        surface: *Surface,
+        format: TextFormat,
+        max_rows: u32,
+        result: *Text,
+    ) bool {
+        if (max_rows == 0) return false;
+        surface.core_surface.renderer_state.mutex.lockUncancelable(global.io());
+        defer surface.core_surface.renderer_state.mutex.unlock(global.io());
+
+        const screen = surface.core_surface.renderer_state.terminal.screens.get(.primary) orelse
+            return false;
+        const pages = &screen.pages;
+
+        // The cursor row, counted from the top of the whole screen.
+        const cursor_pin = screen.cursor.page_pin.*;
+        const cursor_row = (pages.pointFromPin(.screen, cursor_pin) orelse return false).screen.y;
+        const first_row = cursor_row -| (max_rows - 1);
+
+        const start = pages.pin(.{ .screen = .{ .x = 0, .y = first_row } }) orelse return false;
+        const end = pages.pin(.{ .screen = .{ .x = pages.cols - 1, .y = cursor_row } }) orelse
+            return false;
+
+        const text = screen.selectionString(global.alloc(), .{
+            .sel = terminal.Selection.init(start, end, false),
+            .trim = false,
+            .emit = format.core(),
+        }) catch |err| {
+            log.warn("error reading history err={}", .{err});
+            return false;
+        };
+
+        result.* = .{
+            .tl_px_x = -1,
+            .tl_px_y = -1,
+            .offset_start = 0,
+            .offset_len = 0,
+            .text = text.ptr,
+            .text_len = text.len,
+        };
+        return true;
+    }
