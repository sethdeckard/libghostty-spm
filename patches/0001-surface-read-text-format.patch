-        const text = core_surface.dumpTextLocked(
+        const text = core_surface.dumpTextFormattedLocked(
             global.alloc,
             core_sel,
+            emit,
         ) catch |err| {
             log.warn("error reading text err={}", .{err});
             return false;
@@ -2218,7 +2278,7 @@ pub const CAPI = struct {
