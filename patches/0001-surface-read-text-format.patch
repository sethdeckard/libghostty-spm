+    /// Same as ghostty_surface_read_text but emits the text in the given
+    /// format. GHOSTTY_TEXT_FORMAT_VT preserves colors and styles as
+    /// escape sequences, predominantly SGR.
+    ///
+    /// Rows are separated by \r\n rather than \n, so the cursor returns
+    /// to column 0 when the output is replayed into a terminal.
+    ///
+    /// VT output additionally includes trailing cells that carry styling
+    /// but no text, such as regions erased with a background color,
+    /// emitted as styled spaces. The plain read omits them. After
+    /// normalizing \r\n to \n, stripping escape sequences, and trimming
+    /// trailing whitespace on each row, the two are identical.
+    ///
+    /// Row blankness ignores styling, so a row that is entirely
+    /// background color with no text is dropped in both formats. A
+    /// colored region survives only on a row holding at least one
+    /// character.
+    ///
+    /// Palette-indexed colors are emitted as palette indices rather than
+    /// being resolved to RGB, so the consumer applies its own palette.
+    /// Direct RGB colors are emitted as-is.
+    ///
+    /// Free the result with ghostty_surface_free_text, as with the plain
+    /// read. This is an expensive operation; cache and throttle it.
+    export fn ghostty_surface_read_text_format(
+        surface: *Surface,
+        sel: Selection,
+        format: TextFormat,
+        result: *Text,
+    ) bool {
+        surface.core_surface.renderer_state.mutex.lock();
+        defer surface.core_surface.renderer_state.mutex.unlock();
+
+        const core_sel = sel.core(
+            surface.core_surface.renderer_state.terminal.screens.active,
+        ) orelse return false;
+
+        return readTextLocked(surface, core_sel, format.core(), result);
     }
 
     fn readTextLocked(
         surface: *Surface,
         core_sel: terminal.Selection,
+        emit: terminal.formatter.Format,
         result: *Text,
     ) bool {
         const core_surface = &surface.core_surface;
 
