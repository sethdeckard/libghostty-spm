diff --git i/src/Surface.zig w/src/Surface.zig
index 5d16f3326..c485813bf 100644
--- i/src/Surface.zig
+++ w/src/Surface.zig
@@ -1919,11 +1919,30 @@ pub fn dumpTextLocked(
     self: *Surface,
     alloc: Allocator,
     sel: terminal.Selection,
+) !Text {
+    return try self.dumpTextFormattedLocked(alloc, sel, .plain);
+}
+
+/// Same as `dumpTextLocked` but emits the text in the given format. A
+/// styled format such as `.vt` preserves colors and styles as escape
+/// sequences.
+///
+/// Styled output is not the plain text plus escapes. It separates rows
+/// with \r\n rather than \n, and emits a styled space for a trailing
+/// cell that carries styling but no text, which the plain format omits.
+/// The two match after normalizing \r\n to \n, stripping escape
+/// sequences, and trimming trailing whitespace on each row.
+pub fn dumpTextFormattedLocked(
+    self: *Surface,
+    alloc: Allocator,
+    sel: terminal.Selection,
+    emit: terminal.formatter.Format,
 ) !Text {
     // Read out the text
     const text = try self.io.terminal.screens.active.selectionString(alloc, .{
         .sel = sel,
         .trim = false,
+        .emit = emit,
     });
     errdefer alloc.free(text);
 
